# Copy this file to `.env` and fill values for local development
# Do NOT commit your `.env` to git.

# Django secret key
DJANGO_SECRET_KEY=replace_me_with_a_secure_value

# Debug mode (True/False)
DJANGO_DEBUG=False

# Comma-separated allowed hosts, e.g. localhost,127.0.0.1,yourdomain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
